# Render 환경변수 설정 (Render 대시보드 > Environment 에서 입력)
API_KEY=여기에_학교_API_키_입력

# Supabase 프로젝트 Connect > Direct 탭 > "Session pooler" 연결 문자열을 그대로 넣으세요.
# 예: postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
# (db.<ref>.supabase.co 직접 연결 주소는 IPv6 전용이라 Render에서 접속이 안 됩니다 — 반드시 pooler 주소를 쓰세요)
DATABASE_URL=여기에_Supabase_Session_Pooler_연결_문자열_입력

PORT=3000
